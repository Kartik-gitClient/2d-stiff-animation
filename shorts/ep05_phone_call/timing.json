   "spk": "N",
   "text": "रात के दो बजे, सिमरन के फ़ोन पर कॉल आई। नंबर उसका अपना था।",
   "dur": 4.17
  },
  {
   "t0": 5.01,
   "t1": 7.2,
   "spk": "N",
   "text": "उसने हिचकिचाते हुए उठाया।",
   "dur": 1.55
  },
  {
   "t0": 7.2,
   "t1": 12.49,
   "spk": "X",
   "text": "सिमरन, दरवाज़ा मत खोलना। वो आ रही है।",
